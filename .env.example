# Copy to .env and fill in. Never commit .env.

# Links in emails point here (use your Tailscale / LAN / public URL)
HF_BASE_URL=https://house.tamairnv.co.uk

# Optional basic auth for the web UI (strongly recommended if exposed via a tunnel)
HF_UI_USERNAME=
HF_UI_PASSWORD=

# Email via Gmail: create an App Password at https://myaccount.google.com/apppasswords
HF_SMTP_HOST=smtp.gmail.com
HF_SMTP_PORT=587
HF_SMTP_STARTTLS=true
HF_SMTP_USERNAME=you@gmail.com
HF_SMTP_PASSWORD=
HF_SMTP_FROM=House finder <you@gmail.com>

# Optional: real walking/cycling times from openrouteservice.org (free key)
HF_ORS_API_KEY=

# Scraping
HF_REQUEST_DELAY_SECONDS=4
HF_DUMP_HTML=false
HF_PLAYWRIGHT_ENABLED=false
HF_SCHEDULER_ENABLED=true

# AI overview + Q&A on each listing (console.anthropic.com → API keys). Leave blank to hide the AI buttons.
HF_ANTHROPIC_API_KEY=
# HF_AI_MODEL=claude-opus-5-5
# HF_AI_EFFORT=medium

# "Who can log in" panel in Settings edits your Cloudflare Access allow-list.
# Token: Cloudflare → My Profile → API Tokens → Custom: Account / Access: Apps and Policies / Edit (+ Account Settings / Read)
HF_CF_API_TOKEN=
# Only these emails can edit the list (comma separated). Empty = anyone who can sign in.
HF_ADMIN_EMAILS=

# ---- Several sites + the admin site (see PLAN.md §14) ----
# Only these emails can use the admin site (and they can log in to every site). Also used above.
# HF_ADMIN_EMAILS=you@gmail.com
HF_ADMIN_HOST=house-admin.tamairnv.co.uk
# Access login check (team domain is shared; each site's AUD is stored in data/admin.db by the setup button)
HF_CF_TEAM_DOMAIN=
HF_CF_ACCESS_AUD=
# Filled in by `python -m app.cli setup-admin` (kept in data/admin.db); set here only to override
HF_ADMIN_ACCESS_AUD=
HF_SITE_DOMAIN=tamairnv.co.uk
HF_CF_TUNNEL_ID=1b7d6f75-aeea-4d8a-9026-1266a79e8e28
HF_TUNNEL_SERVICE=http://localhost:8095
# The token above also needs: Account / Cloudflare Tunnel / Edit, Account / Access: Apps and Policies / Edit,
# Zone (tamairnv.co.uk) / DNS / Edit for the "New site" button to put sites online.
