# Copy to .env and fill in. Never commit .env.

# Links in emails point here (use your Tailscale / LAN / public URL)
HF_BASE_URL=http://100.126.112.62:8095

# Optional basic auth for the web UI (strongly recommended if exposed via a tunnel)
HF_UI_USERNAME=
HF_UI_PASSWORD=

# Email via Gmail: create an App Password at https://myaccount.google.com/apppasswords
HF_SMTP_HOST=smtp.gmail.com
HF_SMTP_PORT=587
HF_SMTP_STARTTLS=true
HF_SMTP_USERNAME=you@gmail.com
HF_SMTP_PASSWORD=
HF_SMTP_FROM=House finder <you@gmail.com>

# Optional: real walking/cycling times from openrouteservice.org (free key)
HF_ORS_API_KEY=

# Scraping
HF_REQUEST_DELAY_SECONDS=4
HF_DUMP_HTML=false
HF_PLAYWRIGHT_ENABLED=false
HF_SCHEDULER_ENABLED=true
